# ============================================================
# test-system 环境变量模板（根目录副本）
# 实际生效文件：backend/.env（config.py 从 backend 目录读取 .env）
# 使用方式：
#   Windows:  copy backend\.env.example backend\.env
#   Linux:    cp backend/.env.example backend/.env
# 严禁将 .env 提交到版本库（已在 .gitignore 排除）
# ============================================================

# ---- JWT 安全配置（必填，禁止使用示例值启动生产环境）----
# 生成强随机密钥示例：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-char-string

# JWT 签名算法与过期时间（分钟）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 数据库连接（默认使用 backend 目录下 SQLite 文件）----
DATABASE_URL=sqlite:///./test_system.db

# ---- CORS：允许的前端开发服务器来源（逗号分隔）----
CORS_ORIGINS=http://localhost:5173
